{
  "$defs": {
    "AccountIn": {
      "additionalProperties": false,
      "properties": {
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "bank_id": {
          "title": "Bank Id",
          "type": "string"
        },
        "home_location_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Location Id"
        }
      },
      "required": [
        "account_ref",
        "bank_id"
      ],
      "title": "AccountIn",
      "type": "object"
    },
    "ComplaintCategory": {
      "enum": [
        "digital_arrest",
        "investment_scam",
        "upi_phishing",
        "task_job_scam"
      ],
      "title": "ComplaintCategory",
      "type": "string"
    },
    "ComplaintIn": {
      "additionalProperties": false,
      "properties": {
        "amount_paise": {
          "exclusiveMinimum": 0,
          "title": "Amount Paise",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/ComplaintCategory"
        },
        "credited_at": {
          "format": "date-time",
          "title": "Credited At",
          "type": "string"
        },
        "external_ref": {
          "title": "External Ref",
          "type": "string"
        },
        "layer1_account": {
          "$ref": "#/$defs/AccountIn"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reported_event_at": {
          "format": "date-time",
          "title": "Reported Event At",
          "type": "string"
        },
        "victim_district_id": {
          "title": "Victim District Id",
          "type": "string"
        }
      },
      "required": [
        "external_ref",
        "category",
        "amount_paise",
        "victim_district_id",
        "credited_at",
        "reported_event_at",
        "observed_at",
        "layer1_account"
      ],
      "title": "ComplaintIn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ComplaintIn"
      },
      "maxItems": 500,
      "title": "Items",
      "type": "array"
    },
    "sim_time": {
      "format": "date-time",
      "title": "Sim Time",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "idempotency_key",
    "sim_time",
    "items"
  ],
  "title": "ComplaintBatch",
  "type": "object"
}
