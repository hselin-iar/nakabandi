[importlinter]
# Boundary contracts from DOC 2 §2.6 (rule table). Every rule there that import-linter can
# express is encoded here; the other rows are enforced by ruff (wall clock), eslint-plugin-boundaries
# (web features) and the `npm run types` diff check (generated client).
root_packages =
    nakabandi
    nakabandi_contracts
    worldsim
include_external_packages = True

# Row 1: interfaces -> application -> domain; infrastructure never imports interfaces.
# (interfaces) is optional because only modules that expose HTTP have that layer.
[importlinter:contract:layers]
name = Layers inside every API module
type = layers
layers =
    (interfaces)
    (infrastructure)
    application
    domain
containers =
    nakabandi.intake
    nakabandi.graph
    nakabandi.forecast
    nakabandi.interception
    nakabandi.alerting
    nakabandi.casework
    nakabandi.access
    nakabandi.audit
    nakabandi.geo
    nakabandi.analytics

# Row 2: a module may import another module only through its public facade.
# Direct imports of another module's sub-modules are forbidden; importing the facade is allowed.
[importlinter:contract:facade-intake]
name = intake uses other modules only through their facades
type = forbidden
source_modules =
    nakabandi.intake
forbidden_modules =
    nakabandi.graph.**
    nakabandi.forecast.**
    nakabandi.interception.**
    nakabandi.alerting.**
    nakabandi.casework.**
    nakabandi.access.**
    nakabandi.audit.**
    nakabandi.geo.**
    nakabandi.analytics.**
    nakabandi.evaluation.**
    nakabandi.pipeline.**
allow_indirect_imports = True
[importlinter:contract:facade-graph]
name = graph uses other modules only through their facades
type = forbidden
source_modules =
    nakabandi.graph
forbidden_modules =
