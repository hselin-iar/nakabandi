# Row 3: domain code stays pure.
[importlinter:contract:domain-purity]
name = domain packages do not import I/O or framework libraries
type = forbidden
source_modules =
    nakabandi.*.domain
forbidden_modules =
    sqlalchemy
    fastapi
    httpx
    os
    requests
allow_indirect_imports = True

# Row 5: hidden-truth firewall (the API process never reads the oracle).
[importlinter:contract:firewall-main]
name = main.py does not import evaluation
type = forbidden
source_modules =
    nakabandi.main
forbidden_modules =
    nakabandi.evaluation
allow_indirect_imports = True

# Row 6: orchestration lives in pipeline; no module imports pipeline.
[importlinter:contract:pipeline-is-top]
name = no module imports pipeline
type = forbidden
source_modules =
    nakabandi.intake
    nakabandi.graph
    nakabandi.forecast
    nakabandi.interception
    nakabandi.alerting
    nakabandi.casework
    nakabandi.access
    nakabandi.audit
    nakabandi.geo
    nakabandi.analytics
    nakabandi.evaluation
    nakabandi.shared
forbidden_modules =
    nakabandi.pipeline
allow_indirect_imports = True

# Row 7: the shared contracts package imports nothing from the apps.
[importlinter:contract:contracts-are-leaf]
name = packages/contracts imports nothing from apps
type = forbidden
source_modules =
    nakabandi_contracts
forbidden_modules =
    nakabandi
    worldsim
allow_indirect_imports = True
