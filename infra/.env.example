# Names only, no values. Copy to .env locally; .env is git-ignored.
# Bank gateway simulator (DOC 3, apps/bank-sim config.ts).
WEBHOOK_SECRET=
API_BASE_URL=
SIM_STATUS_URL=
# Bank-sim console login (apps/bank-sim)
CONSOLE_USER=
CONSOLE_PASS=
# Signs the bank-sim console's session cookie; independent of WEBHOOK_SECRET.
SESSION_SECRET=
PORT=

# Shared machine-client secret (DOC 4 §4.4): the SAME value authenticates apps/bank-sim's calls
# to the API and the API's /ingest/* routes (world-sim, npm run seed). Read by both processes.
API_SERVICE_KEY=

# API process (DOC 4 §4.4). Optional: Settings falls back to sqlite:///nakabandi.db when unset.
DATABASE_URL=

# API process (DOC 4 §4.4). Signs the session JWT cookie (DOC 2 §2.2 auth decision); required.
# Use at least 32 random bytes (e.g. `openssl rand -base64 32`); HS256 warns below that length.
JWT_SECRET=

# docker-compose.yml / Caddyfile (DOC 4 §4.4, Step A5). The public domain Caddy serves and gets
# an HTTPS certificate for. Leave unset (defaults to "localhost") for the offline-laptop path.
CADDY_DOMAIN=

# API process, alert delivery (DOC 4 Step A8). All optional; names only, no values.
# Where the API POSTs signed hold requests / bank notices (LC-6): the bank gateway's
# /webhooks/nakabandi. WEBHOOK_SECRET (above) signs them; unset URL or secret = the delivery
# fails and dead-letters visibly in the outbox instead of being sent unsigned.
NAKABANDI_BANK_WEBHOOK_URL=
# Email via SMTP (Mailpit locally). Unset = emails are recorded in the outbox only.
NAKABANDI_SMTP_HOST=
NAKABANDI_SMTP_PORT=
# SMS sandbox provider. Unset or failing = automatic fallback to the on-screen SMS outbox.
NAKABANDI_SMS_PROVIDER_URL=
NAKABANDI_SMS_PROVIDER_KEY=
# In-process workers (default true). Set false to run the outbox / timer driver yourself.
NAKABANDI_OUTBOX_WORKER_ENABLED=
NAKABANDI_TIMER_WORKER_ENABLED=


# Hosted-demo protections (DOC 2 §2.7 "Public exposure"; DOC 4 A11). Names only. All optional and
# all OFF unless set: nothing in the product depends on them.
# NAKABANDI_HOSTED_DEMO=true switches on the hosted defaults: 25 SSE streams, control-gate rate
# limit, auto-pause after 15 minutes without a viewer, nightly reset at 03:00 UTC.
NAKABANDI_HOSTED_DEMO=
# Each default above can be set explicitly (0 or empty = not enforced).
NAKABANDI_MAX_SSE_STREAMS=
NAKABANDI_CONTROL_RATE_PER_MIN=
NAKABANDI_AUTO_PAUSE_AFTER_MIN=
# Nightly reset time, HH:MM in UTC. Empty switches the reset off even in hosted mode.
NAKABANDI_NIGHTLY_RESET_AT=
# world-sim's control API base (e.g. http://world-sim:8100/control): auto-pause and the reset use it.
NAKABANDI_SIM_CONTROL_URL=
# The seed the reset restores (default data/seed/mini_ingest.jsonl).
NAKABANDI_SEED_FILE=
# GET /auth/demo-users publishes the demo credentials. Default true (local, offline and hosted
# DEMOS need it); set false for any deployment that is not a demo (DOC 2 §2.8 T19).
NAKABANDI_DEMO_USERS_ENABLED=
