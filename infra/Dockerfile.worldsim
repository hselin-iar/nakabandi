# NAKABANDI world-sim image (DOC 3 M1, DOC 4 Step B5): runs the real simulator's live control
# server (`worldsim live`), which streams synthetic complaints into the API's /ingest routes.
# Build context is the repo root (docker compose sets it below), since this needs both the
# workspace root files and apps/world-sim/. Mirrors infra/Dockerfile.api's build pattern.
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim
WORKDIR /repo
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
COPY packages/contracts/ packages/contracts/
COPY apps/world-sim/ apps/world-sim/
RUN uv sync --frozen --no-dev --package nakabandi-world-sim

COPY config/ config/

EXPOSE 8100 8002
CMD ["uv", "run", "worldsim", "live", "--config", "config/sim.default.yaml", "--control-port", "8100", "--oracle-port", "8002"]
