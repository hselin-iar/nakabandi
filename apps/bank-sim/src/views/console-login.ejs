<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — NAKABANDI Bank Console</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #0f1117; color: #e2e8f0;
           display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .card { background: #1e2130; border: 1px solid #2d3748; border-radius: 10px; padding: 2.5rem 2rem; width: 340px; }
    h1 { font-size: 1.1rem; color: #63b3ed; font-weight: 700; margin-bottom: 1.5rem; text-align: center; }
    label { display: block; font-size: 0.82rem; color: #a0aec0; margin-bottom: 0.25rem; margin-top: 1rem; }
    input { width: 100%; padding: 0.55rem 0.75rem; border-radius: 5px; border: 1px solid #4a5568; background: #0f1117; color: #e2e8f0; font-size: 0.9rem; }
    button { margin-top: 1.5rem; width: 100%; padding: 0.6rem; border: none; border-radius: 5px; background: #2b4c7e; color: #fff; font-weight: 600; cursor: pointer; font-size: 0.9rem; }
    .error { margin-top: 1rem; color: #fc8181; font-size: 0.82rem; text-align: center; }
    .tagline { text-align: center; color: #4a5568; font-size: 0.75rem; margin-top: 1.25rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Bank Nodal Console</h1>
    <form method="POST" action="/console/login">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" required />
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <button type="submit">Sign In</button>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
    </form>
    <p class="tagline">NAKABANDI · Bank Gateway Simulator · Demo only</p>
  </div>
</body>
</html>
