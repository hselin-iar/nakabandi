<%
  // console-list.ejs — list all webhook requests grouped by status
  const title = "Requests";
  const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  const rows = requests.map((r) => {
    const body = JSON.parse(r.body_json);
    const lien = lienByReqId[r.request_id];
    const cb = callbackByReqId[r.request_id];
    const proposed = body.proposed_lien_paise != null ? (body.proposed_lien_paise / 100).toFixed(2) : "—";
    const applied = lien ? (lien.applied_paise / 100).toFixed(2) : "—";
    const cbStatus = cb ? (cb.success ? cb.status : "pending") : "—";
    const id = esc(r.request_id);
    return `<tr>
      <td><a href="/console/requests/${id}">${id.slice(0, 16)}…</a></td>
      <td>${esc(r.kind)}</td>
      <td><span class="badge badge-${esc(r.status)}">${esc(r.status)}</span></td>
      <td style="font-size:0.78rem;color:#718096">${esc(r.received_at.replace("T", " ").slice(0, 19))}</td>
      <td>${proposed}</td>
      <td>${applied}</td>
      <td style="font-size:0.78rem">${esc(cbStatus)}</td>
      <td><a href="/console/requests/${id}">View →</a></td>
    </tr>`;
  }).join("");

  const table = requests.length === 0
    ? '<p style="color:#718096;font-size:0.9rem">No webhook requests received yet.</p>'
    : `<table>
  <thead>
    <tr>
      <th>Request ID</th>
      <th>Kind</th>
      <th>Status</th>
      <th>Received At</th>
      <th>Proposed (₹)</th>
      <th>Applied (₹)</th>
      <th>Callback</th>
      <th></th>
    </tr>
  </thead>
  <tbody>${rows}</tbody>
</table>`;

  const body = `<div class="nav-bar">
  <strong style="font-size:1.1rem">Webhook Requests</strong>
  <span style="color:#718096;font-size:0.8rem">Auto-refreshes on action</span>
</div>
${table}`;
%>
<%- include('layout', { title, body }) %>
